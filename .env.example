# ==============================================================================
# PyMastery Configuration
# ==============================================================================

# --- Database Configuration ---
# PostgreSQL database connection URL for centralized auth, profiles, and sync.
# Automatically normalizes 'postgres://' to 'postgresql://'.
# If unset or empty, PyMastery falls back to local SQLite at server/data/pymastery.db.
#
# Examples:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/pymastery
#   DATABASE_URL=postgres://user:password@cloud-provider-host:5432/dbname?sslmode=require
DATABASE_URL=

# --- Server Configuration ---
# PORT=8000
# HOST=0.0.0.0

# --- Authentication ---
# PYMASTERY_SECRET_KEY=pymastery-study-secret-key-2026

# --- AI Tutor LLM Providers (Optional) ---
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# CUSTOM_LLM_URL=
# CUSTOM_LLM_KEY=
# CUSTOM_LLM_MODEL=
